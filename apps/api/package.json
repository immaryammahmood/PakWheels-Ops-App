{
  "name": "@pakwheels/tasktrack-api",
  "version": "0.1.0",
  "private": true,
  "description": "TaskTrack Phase 1C backend foundation",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "test:unit": "tsc -p tsconfig.json && node --test dist/test/*.unit.test.js",
    "test:integration": "tsc -p tsconfig.json && node --test dist/test/api.integration.test.js",
    "start": "node dist/src/main.js",
    "db:migrate": "npm run build && node scripts/migrate.mjs",
    "db:migrate:up": "npm run db:migrate -- up",
    "check:migrations": "npm run build && tsc --noEmit --allowJs --checkJs --strict --module NodeNext --moduleResolution NodeNext --target ES2023 scripts/migrate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
