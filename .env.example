# Template only; no services are configured by this file.
# Empty values must be decided in a separately authorized phase.
APP_ENV=
APP_TIMEZONE=Asia/Karachi

API_HOST=
API_PORT=

# Development PostgreSQL access only. Server: 192.168.110.15/20;
# PakWheels LAN: 192.168.96.0/20. PostgreSQL must not bind to the LAN address
# or be directly accessible from the LAN. These are not production settings.
# Supply process environment explicitly; the API and runner do not auto-load this file.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Separately provisioned migration identity; never falls back to DATABASE_*.
# No migration execution on API startup. From apps/api, explicitly use
# npm run db:migrate:up only after runtime and migration execution are approved.
# Only up is supported; status/dry-run/down are deliberately not exposed.
MIGRATION_DATABASE_HOST=127.0.0.1
MIGRATION_DATABASE_PORT=5432
MIGRATION_DATABASE_NAME=
MIGRATION_DATABASE_USER=
MIGRATION_DATABASE_PASSWORD=

ADMIN_PORT=

INTERNAL_APP_HOSTNAME=
ALLOWED_LAN_CIDR=192.168.96.0/20

EVIDENCE_STORAGE_PATH=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
